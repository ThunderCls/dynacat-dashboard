# Copy to .env and fill in. Every value below is referenced by config/dynacat.yml.

# Base domain your services are published under. The dashboard builds links
# like https://jellyfin.${PUBLIC_DOMAIN} from it.
PUBLIC_DOMAIN=example.com

# Container timezone.
TZ=America/New_York

# Weather widget. Free text, as specific as you can make it.
WEATHER_LOCATION=Austin, Texas, United States

# Admin bookmarks, as a single-line flow-style YAML list. Add as many entries
# as you like. Quote both fields, a comma or brace inside an unquoted value
# breaks the list. Deep links that embed an account/tenant id belong here
# rather than in the config, which is why this is a variable.
BOOKMARK_LINKS=[{title: "Cloud Console", url: "https://cloud.example.com/"}, {title: "DNS", url: "https://dns.example.com/"}]

# Where the Docker widget's stack names link to, your Docker management UI
# (Portainer, Komodo, Dozzle, Dockge...). Any URL; used only as a link target.
DOCKER_UI_URL=http://localhost:9000/

# --- Glances -----------------------------------------------------------------
# REQUIRED for the Host, Resources and Top Consumers widgets. Without it they
# show a connection error; every other widget is unaffected.
#
# host:port of a Glances instance with its web API enabled (glances -w).
# There is no sane default here, so set it deliberately:
#
#   Glances on the host  -> use the gateway of the network THIS container
#                           joins. The shipped compose.yaml joins `dynacat`:
#     docker network inspect dynacat -f '{{(index .IPAM.Config 0).Gateway}}'
#                           NOT docker0's 172.17.0.1 - the container is not
#                           on the default bridge.
#   Glances in a container on the same network -> just use  glances:61208
#
# Glances must LISTEN on that address (a 127.0.0.1-only bind is unreachable
# from a container) and the host firewall must allow it.
GLANCES_HOST=CHANGEME:61208

# Network interface Glances reports, e.g. eth0, ens5, enp1s0:  ip -br link
NET_INTERFACE=eth0

# Mount point of the host root filesystem as Glances reports it. Glances in a
# container usually sees it as /rootfs; installed on the host it is /.
ROOT_MOUNT=/rootfs

# Physical disk Glances reports read/write rates for:  lsblk -dno NAME
DISK_NAME=sda

# --- Jellyfin ----------------------------------------------------------------
# Dashboard > API Keys creates the key. The user ID is the userId= value in the
# URL when you open Dashboard > Users and click your user.
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=

# --- GitHub ------------------------------------------------------------------
# Releases widget. A classic token with no scopes is enough; it only raises the
# public rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=
